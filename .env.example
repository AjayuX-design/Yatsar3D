# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Names only here. No real values in this file.

# Your store's Shopify domain, for example your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API token from the Headless channel. Server-side only.
# Either the private token (starts with shpat_) or the public token (32 characters) works.
# Never add NEXT_PUBLIC_ to this name.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Optional. Defaults to 2026-07. Set to the newest stable version in Shopify's docs.
SHOPIFY_API_VERSION=

# Optional. Set to true to show built-in sample products instead of Shopify,
# for building the interface. Leave empty or remove for real data.
SHOPIFY_USE_SAMPLE_DATA=

# Optional. Public address of the storefront, used in WhatsApp links.
# Defaults to the Vercel address, or localhost when developing.
SITE_URL=

# Custom order form. Each request is emailed through your Hostinger mailbox,
# with the photos attached. Without these two, the form stays hidden and the page
# shows WhatsApp only. The password is the mailbox password. Keep it in Vercel
# (Sensitive) and in .env.local only, never in the code.
SMTP_USER=
SMTP_PASSWORD=
# Optional. Defaults: smtp.hostinger.com, port 465, delivered to SMTP_USER.
SMTP_HOST=
SMTP_PORT=
CUSTOM_ORDER_TO_EMAIL=
# Local testing only: shows the form and skips sending (ignored in production).
CUSTOM_ORDER_DRY_RUN=

# Customer reviews
# Review database: add "Upstash Redis" from the Vercel Marketplace; it sets these two for you.
# (UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN also work.) Without them, production hides the reviews.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Password for /admin/reviews, where you reply to, hide or delete reviews.
ADMIN_PASSWORD=
# Optional: where new-review emails go. Defaults to CUSTOM_ORDER_TO_EMAIL, then SMTP_USER.
REVIEW_NOTIFY_TO=

# Customer accounts ("My orders"). Sign-in happens on Shopify's page with an emailed code.
# In Shopify admin: Headless channel > your storefront > Customer Account API > Application setup.
# Client ID of that app (a public client: no secret needed). Without it, the account area stays hidden.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Shopify's numeric shop id (not secret). Shown in the Application endpoints of the Customer Account API page, e.g. in https://shopify.com/authentication/<this number>/oauth/authorize.
SHOPIFY_SHOP_ID=
# Optional. Defaults to 2026-10.
CUSTOMER_ACCOUNT_API_VERSION=
# Local testing only: a pretend signed-in customer with sample orders (ignored in production).
CUSTOMER_ACCOUNT_DEMO=
