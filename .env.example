# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Names only here. No real values in this file.

# Your store's Shopify domain, for example your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API token from the Headless channel. Server-side only.
# Either the private token (starts with shpat_) or the public token (32 characters) works.
# Never add NEXT_PUBLIC_ to this name.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Optional. Defaults to 2026-07. Set to the newest stable version in Shopify's docs.
SHOPIFY_API_VERSION=

# Optional. Set to true to show built-in sample products instead of Shopify,
# for building the interface. Leave empty or remove for real data.
SHOPIFY_USE_SAMPLE_DATA=

# Optional. Public address of the storefront, used in WhatsApp links.
# Defaults to the Vercel address, or localhost when developing.
SITE_URL=

# Custom order form. Each request is emailed through your Hostinger mailbox,
# with the photos attached. Without these two, the form stays hidden and the page
# shows WhatsApp only. The password is the mailbox password. Keep it in Vercel
# (Sensitive) and in .env.local only, never in the code.
SMTP_USER=
SMTP_PASSWORD=
# Optional. Defaults: smtp.hostinger.com, port 465, delivered to SMTP_USER.
SMTP_HOST=
SMTP_PORT=
CUSTOM_ORDER_TO_EMAIL=
# Local testing only: shows the form and skips sending (ignored in production).
CUSTOM_ORDER_DRY_RUN=
